// This is a variable foreach

void main(){
    int a, i, j;
    a = 9;

    foreach (i : 0 .. a) {
        foreach (j : 0 .. i) {
            print i;
            print " ";
        }
        println "";
    }

    println "";

    foreach (i : a..0) {
        foreach (j : 0 .. i) {
            print i;
            print " ";
        }
        println "";
    }
    println "";
    
}