// This program prints the first 30 prime numbers.

bool isPrime(int n) {
    if (n <= 1) return false;
    int i;
    for (i = 2; i * i <= n; i++) {
        if (n % i == 0) return false;
    }
    return true;
}

void main(){
    
    int i, count = 0;
    const int limit = 30;

    print "Prime numbers up to ";
    println limit;
    
    for (i = 2; count < limit; i++) {
        if (isPrime(i)) {
            print i;
            print " ";
            count++;
        }
    }
    println "";
}