// Float arithmetic operations and comparisons

void main(){
    float a;
    float b;
    float c;

    a = 1.5;
    b = 2.5;
    c = a + b;

    print "a = ";
    println a;
    print "b = ";
    println b;

    print "Sum of a and b = ";
    println a + b;
    
    print "Difference of a and b = ";
    println a - b;

    print "Product of a and b = ";
    println a * b;

    print "Quotient of a and b = ";
    println a / b;

    print "a > b: ";
    println a > b;

    print "a < b: ";
    println a < b;
}