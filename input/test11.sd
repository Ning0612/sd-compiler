// 測試作用域規則
int global = 100;

int testFunction(int param) {
    int local = 50;
    
    // 參數和局部變量
    param = param + local;
    
    // 訪問全局變量
    global = global + 1;
    
    return param;
}

void main() {
    int mainlocal = 20;
    
    {
        // 塊作用域
        int blockvar = 30;
        mainlocal = mainlocal + blockvar;
        
        {
            // 嵌套塊
            int nestedvar = 40;
            blockvar = blockvar + nestedvar;
        }
        
        println blockvar; // 70
    }
    
    int result = testFunction(mainlocal);
    println result; // 100
    println global; // 101
    
    // 同名變量覆蓋
    {
        int global = 999;  // 局部變量覆蓋全局變量
        println global; // 應該是局部的值 999
    }
    
    println global;  // 應該還是全局的值 101
}