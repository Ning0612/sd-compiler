// if else-if else structure example

void main(){
    int a = 3;
    foreach (a : 3..7){
        print "a = ";
        println a;
        if (a > 5) {
            println "a is greater than 5";
        } else if (a == 5) {
            println "a is equal to 5";
        } else {
            println "a is less than 5";
        }
    }
}