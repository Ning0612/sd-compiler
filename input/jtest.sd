// 測試基本數據類型和常量
const int MAX_VALUE = 100;
const bool FLAG = true;
const string MSG = "Hello World";
const float PI = 3.14;

int globalInt = 10;
bool globalBool = false;
float globalFloat = 2.5;

void main() {
    int a = 2, b = 3, c = a + b;
    const int d = 5;
    int e = d * 2;

    println a;
    println b;
    println c;
    println d;
    println e;

    foreach ( a : 1..5 ) {
        println a;
        a = 10;
    }

    foreach ( a : 10..1 ) {
        println a;
        a = 0;
    }

    foreach ( a : 1..5 ) {
        print a;
        print " ";
    }

    println "";

    foreach ( a : 10..1 ) {
        print a;
        print " ";
    }

    println "";
}